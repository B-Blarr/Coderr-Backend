# Copy this file to .env and fill in the values.

# Required. Generate a new one for every environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY='your-secret-key-here'

# Development defaults. Set DEBUG=False in production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=

# Set when serving from a subpath, e.g. /coderr
FORCE_SCRIPT_NAME=

# PostgreSQL. These values match the local container from compose.yml.
# On the server use the real credentials and port 5432.
# DB_NAME is required, Django refuses to start without it.
DB_NAME=coderr
DB_USER=coderr
DB_PASSWORD=coderr
DB_HOST=127.0.0.1
DB_PORT=5433

# HSTS. Only enable once HTTPS is verified and working.
# HSTS_SECONDS=31536000
# HSTS_INCLUDE_SUBDOMAINS=True

# Email for the contact form. Without EMAIL_HOST_USER Django only writes
# outgoing mail to the console instead of sending it.
# EMAIL_HOST=mail.gmx.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
# CONTACT_RECIPIENT=

# Embedding service for the portfolio assistant, see embedding_service/.
# EMBEDDING_SERVICE_URL=http://127.0.0.1:8002

# Laya input filter for the portfolio assistant, see laya_service/.
# A question is rejected when its jailbreak score reaches the threshold,
# a number greater than 0 and at most 1. Check a new value with
# manage.py evaluate_guard.
# LAYA_SERVICE_URL=http://127.0.0.1:8001
# LAYA_THRESHOLD=0.8

# Portfolio assistant. Off unless set. Keep it off on the server until the
# embedding and Laya services run there.
# ASSISTANT_ENABLED=True

# Sections below this similarity count as off topic, a number greater than 0
# and at most 1. Check a new value with manage.py evaluate_retrieval.
# ASSISTANT_MIN_SIMILARITY=0.76
