# Copy this file to .env and fill in the values.

# Required. Generate a new one for every environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY='your-secret-key-here'

# Development defaults. Set DEBUG=False in production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=

# Set when serving from a subpath, e.g. /coderr
FORCE_SCRIPT_NAME=

# PostgreSQL. Without DB_NAME the project falls back to local SQLite.
# DB_NAME=coderr
# DB_USER=coderr
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# HSTS. Only enable once HTTPS is verified and working.
# HSTS_SECONDS=31536000
# HSTS_INCLUDE_SUBDOMAINS=True

# E-Mail fuer das Kontaktformular. Ohne EMAIL_HOST_USER schreibt Django
# ausgehende Mails nur in die Konsole, statt sie zu versenden.
# EMAIL_HOST=mail.gmx.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
# CONTACT_RECIPIENT=
